# Copy this file to the ignored `.env` file for local Compose only.
# Never place real credentials or secret values in either local file.
PROCUREMENT_ENVIRONMENT=dev
PROCUREMENT_LOG_LEVEL=INFO
# These are intentionally fictional local values. Deployed values come from a secret store.
PROCUREMENT_CRON_TOKEN=fictional-local-cron-token-at-least-32-characters
PROCUREMENT_MCP_TOKEN=fictional-local-mcp-token-at-least-32-characters

# Local walking-skeleton process settings.
PROCUREMENT_MCP_URL=http://127.0.0.1:9000/mcp
PROCUREMENT_MCP_CLIENT_TIMEOUT_SECONDS=5
PROCUREMENT_LOCAL_ERP_MODE=success
PROCUREMENT_MCP_READ_TIMEOUT_SECONDS=1
PROCUREMENT_MCP_MAX_RETRIES=2
PROCUREMENT_MCP_RETRY_DELAY_SECONDS=0.01

# Compose settings. The process-only launcher ignores these values.
PROCUREMENT_FRONTEND_PORT=8080
PROCUREMENT_LOCAL_ERP_URL=http://fake-odoo:8069
PROCUREMENT_FAKE_ODOO_SCENARIO=success
PROCUREMENT_FAKE_ODOO_TIMEOUT_SECONDS=5

# Disposable Odoo 19 JSON-2 contract stack. Values are fictional and local only.
ODOO_CONTRACT_DATABASE=stockai_t10_contract
ODOO_CONTRACT_PORT=8069
ODOO_CONTRACT_POSTGRES_PASSWORD=fictional-t10-postgres-password
ODOO_CONTRACT_LOGIN=stockai-contract@example.invalid
ODOO_CONTRACT_IMAGE=stockai-odoo:t11a-local

# Finite Odoo integration bootstrap. Local Compose writes only to its tmpfs sink.
# Deployed bootstrap Jobs use `secretsmanager` and the exact environment ARN.
STOCKAI_ODOO_BOOTSTRAP_LOGIN=stockai-integration@example.invalid
STOCKAI_ODOO_BOOTSTRAP_KEY_NAME=stockai-procurement-integration
STOCKAI_ODOO_BOOTSTRAP_KEY_EXPIRY_DAYS=30
STOCKAI_ODOO_BOOTSTRAP_ROTATE=false
STOCKAI_ODOO_BOOTSTRAP_SINK=file
STOCKAI_ODOO_BOOTSTRAP_KEY_FILE=/run/stockai-contract/bootstrap-api-key
STOCKAI_ODOO_BOOTSTRAP_SECRET_ARN=

# Only fictional dev or prod profiles are accepted by the seed scripts.
STOCKAI_ODOO_SEED_ENVIRONMENT=dev
