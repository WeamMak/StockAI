# Never place real credentials or secret values in this file.
PROCUREMENT_ENVIRONMENT=dev
PROCUREMENT_LOG_LEVEL=INFO
# Set through a secret store in deployed environments; never commit a real value.
PROCUREMENT_CRON_TOKEN=replace-with-environment-specific-cron-token

# Local walking-skeleton process settings.
PROCUREMENT_MCP_URL=http://127.0.0.1:9000/mcp
PROCUREMENT_MCP_CLIENT_TIMEOUT_SECONDS=5
# The launcher generates this token; set it only when starting processes manually.
PROCUREMENT_MCP_TOKEN=replace-with-an-opaque-token-at-least-32-characters-long
PROCUREMENT_LOCAL_ERP_MODE=success
PROCUREMENT_MCP_READ_TIMEOUT_SECONDS=1
PROCUREMENT_MCP_MAX_RETRIES=2
PROCUREMENT_MCP_RETRY_DELAY_SECONDS=0.01
# Optional when the default frontend port is occupied.
PROCUREMENT_FRONTEND_PORT=5173
