{
  "annotations": {"list": []},
  "editable": false,
  "links": [
    {"title": "LLM and MCP", "type": "link", "url": "/d/stockai-llm-mcp"},
    {"title": "Dependencies and edge", "type": "link", "url": "/d/stockai-dependencies-edge"}
  ],
  "panels": [
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"unit": "reqpm"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 0},
      "id": 1,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (status_class) (rate(procurement_http_requests_total[5m])) * 60", "legendFormat": "{{status_class}}", "refId": "A"}],
      "title": "Requests per minute by result",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"max": 1, "min": 0, "unit": "percentunit"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 0},
      "id": 2,
      "options": {"legend": {"displayMode": "hidden"}},
      "targets": [{"expr": "sum(rate(procurement_http_request_errors_total[5m])) / clamp_min(sum(rate(procurement_http_requests_total[5m])), 0.001)", "refId": "A"}],
      "title": "Request error rate",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 0},
      "id": 3,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [
        {"expr": "histogram_quantile(0.50, sum by (le) (rate(procurement_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p50", "refId": "A"},
        {"expr": "histogram_quantile(0.95, sum by (le) (rate(procurement_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p95", "refId": "B"},
        {"expr": "histogram_quantile(0.99, sum by (le) (rate(procurement_http_request_duration_seconds_bucket[5m])))", "legendFormat": "p99", "refId": "C"}
      ],
      "title": "Request latency p50 / p95 / p99",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 0, "y": 8},
      "id": 4,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (status) (increase(procurement_scans_total[26h]))", "legendFormat": "{{status}}", "refId": "A"}],
      "title": "Scans in the last 26 hours",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"unit": "short"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 8, "y": 8},
      "id": 5,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "sum by (outcome) (increase(procurement_scan_results_total[1h]))", "legendFormat": "{{outcome}}", "refId": "A"}],
      "title": "Scan outcomes",
      "type": "timeseries"
    },
    {
      "datasource": {"type": "prometheus", "uid": "stockai-prometheus"},
      "fieldConfig": {"defaults": {"unit": "s"}, "overrides": []},
      "gridPos": {"h": 8, "w": 8, "x": 16, "y": 8},
      "id": 6,
      "options": {"legend": {"displayMode": "table", "placement": "bottom"}},
      "targets": [{"expr": "histogram_quantile(0.95, sum by (le, trigger) (rate(procurement_scan_duration_seconds_bucket[15m])))", "legendFormat": "{{trigger}} p95", "refId": "A"}],
      "title": "Scan duration p95",
      "type": "timeseries"
    }
  ],
  "refresh": "30s",
  "schemaVersion": 41,
  "tags": ["stockai", "agent", "provisioned"],
  "templating": {"list": []},
  "time": {"from": "now-6h", "to": "now"},
  "timezone": "browser",
  "title": "StockAI Agent Health",
  "uid": "stockai-agent-health",
  "version": 1
}
