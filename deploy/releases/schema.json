{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://stockai.invalid/schemas/release-manifest-v1.json",
  "title": "StockAI immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "createdAt",
    "applicationIdentity",
    "buildInputs",
    "devValidation",
    "images",
    "integrity",
    "provenance",
    "releaseId",
    "schemaVersion",
    "scout",
    "source"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "releaseId": { "$ref": "#/$defs/digest" },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["commit", "tree"],
      "properties": {
        "commit": { "$ref": "#/$defs/gitObject" },
        "tree": { "$ref": "#/$defs/gitObject" }
      }
    },
    "applicationIdentity": { "$ref": "#/$defs/digest" },
    "buildInputs": { "$ref": "#/$defs/imageMap" },
    "images": { "$ref": "#/$defs/imageMap" },
    "provenance": { "$ref": "#/$defs/imageMap" },
    "scout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reportDigest", "status"],
      "properties": {
        "status": { "enum": ["passed", "findings", "error"] },
        "reportDigest": { "$ref": "#/$defs/digest" }
      }
    },
    "devValidation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["attempts", "status"],
      "properties": {
        "status": { "enum": ["pending", "passed", "failed"] },
        "attempts": {
          "type": "array",
          "maxItems": 20,
          "items": { "$ref": "#/$defs/validationAttempt" }
        }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "pending" } } },
          "then": { "properties": { "attempts": { "maxItems": 0 } } },
          "else": { "properties": { "attempts": { "minItems": 1 } } }
        }
      ]
    },
    "createdAt": { "type": "string", "format": "date-time", "pattern": "Z$" },
    "integrity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["algorithm", "digest"],
      "properties": {
        "algorithm": { "const": "sha256" },
        "digest": { "$ref": "#/$defs/digest" }
      }
    }
  },
  "$defs": {
    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "gitObject": {
      "type": "string",
      "pattern": "^(?:[0-9a-f]{40}|[0-9a-f]{64})$"
    },
    "imageMap": {
      "type": "object",
      "additionalProperties": false,
      "required": ["api", "frontend", "mcp", "odoo"],
      "properties": {
        "api": { "$ref": "#/$defs/digest" },
        "frontend": { "$ref": "#/$defs/digest" },
        "mcp": { "$ref": "#/$defs/digest" },
        "odoo": { "$ref": "#/$defs/digest" }
      }
    },
    "validationAttempt": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "argoRevision",
        "evidenceDigest",
        "images",
        "releaseId",
        "result",
        "smokeRunId",
        "timestamp"
      ],
      "properties": {
        "releaseId": { "$ref": "#/$defs/digest" },
        "images": { "$ref": "#/$defs/imageMap" },
        "argoRevision": { "$ref": "#/$defs/gitObject" },
        "smokeRunId": {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{0,127}$"
        },
        "timestamp": { "type": "string", "format": "date-time", "pattern": "Z$" },
        "result": { "enum": ["passed", "failed"] },
        "evidenceDigest": { "$ref": "#/$defs/digest" }
      }
    }
  }
}
