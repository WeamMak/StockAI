#!/usr/bin/env bash
set -euo pipefail

# T18A extends this bounded identity setup with the approved kubeadm join path.
install -d -m 0755 /etc/stockai
printf '%s\n' '${environment}' > /etc/stockai/environment
printf '%s\n' '${cluster_name}' > /etc/stockai/cluster-name
chmod 0644 /etc/stockai/environment /etc/stockai/cluster-name

# The approved Ubuntu image is expected to contain the SSM agent. Fail clearly
# if that prerequisite is absent instead of silently leaving an unmanaged node.
systemctl enable --now amazon-ssm-agent
