# Copy this file to terraform.tfvars, which is ignored by Git, and replace every
# placeholder before planning. Never commit the resulting account values.

administrator_cidr = "203.0.113.10/32"
aws_account_id      = "replace-with-your-12-digit-account-id"

# Resolve this immutable value with the `gh api` command in the runbook.
github_repository_subject = "replace-with-your-owner@id/repository@id"

# Both environments must be protected in GitHub before the apply role is used.
github_apply_environments = ["dev", "prod"]

# S3 names are globally unique. Keep this bucket dedicated to Terraform state.
state_bucket_name     = "replace-with-your-unique-stockai-terraform-state-bucket"
state_key_prefix      = "stockai"
state_lock_table_name = "replace-with-your-stockai-terraform-locks"
