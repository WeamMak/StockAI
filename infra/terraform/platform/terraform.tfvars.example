# Copy this file to terraform.tfvars, which is ignored by Git, and replace the
# placeholders before planning. Never commit account-specific values.

administrator_cidr = "203.0.113.10/32"
ami_id              = "replace-with-approved-ubuntu-ami-id"
cluster_name        = "stockai"

# The normal active baseline is one control plane plus one worker in each ASG:
# six vCPUs total. Before an authorized apply, verify that quota plus any exact
# temporary capacity under review. EC2 InService is not Kubernetes Ready.
worker_capacity = {
  min     = 1
  desired = 1
  max     = 3
}

# The only supported inactive state is:
# worker_capacity = { min = 0, desired = 0, max = 3 }

# During an approved capacity test, change only the intended environment and
# verify its extra vCPU quota first. Remove the override after the test:
# worker_capacity_overrides = {
#   dev = { min = 1, desired = 2, max = 3 }
# }

# Initialize the empty S3 backend with the T15 outputs. Backend values cannot
# come from this tfvars file:
# terraform init \
#   -backend-config="bucket=<state_bucket_name>" \
#   -backend-config="key=<state_key_prefix>/platform/terraform.tfstate" \
#   -backend-config="region=us-east-1" \
#   -backend-config="dynamodb_table=<state_lock_table_name>" \
#   -backend-config="encrypt=true"
