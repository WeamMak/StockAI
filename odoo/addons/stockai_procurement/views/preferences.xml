<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stockai_procurement_preference_list" model="ir.ui.view">
        <field name="name">stockai.procurement.preference.list</field>
        <field name="model">stockai.procurement.preference</field>
        <field name="arch" type="xml">
            <list>
                <field name="scope"/><field name="company_id"/>
                <field name="product_category_id" optional="show"/>
                <field name="product_id" optional="show"/><field name="revision"/>
                <field name="max_price_premium_percent"/>
                <field name="enforcement_mode"/><field name="active"/>
            </list>
        </field>
    </record>
    <record id="view_stockai_procurement_preference_form" model="ir.ui.view">
        <field name="name">stockai.procurement.preference.form</field>
        <field name="model">stockai.procurement.preference</field>
        <field name="arch" type="xml">
            <form string="Recommendation Preference">
                <sheet>
                    <group>
                        <field name="company_id"/><field name="scope"/>
                        <field name="product_category_id" invisible="scope != 'category'" required="scope == 'category'"/>
                        <field name="product_id" invisible="scope != 'product'" required="scope == 'product'"/>
                        <field name="revision" readonly="1"/>
                        <field name="max_price_premium_percent"/>
                        <field name="enforcement_mode"/><field name="active"/>
                    </group>
                    <field name="priority_ids">
                        <list editable="bottom">
                            <field name="sequence" widget="handle"/>
                            <field name="criterion"/>
                        </list>
                    </field>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
    <record id="action_stockai_procurement_preferences" model="ir.actions.act_window">
        <field name="name">Recommendation Preferences</field>
        <field name="res_model">stockai.procurement.preference</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_stockai_procurement_root" name="StockAI Procurement" sequence="90" groups="stockai_procurement.group_stockai_procurement_config_admin"/>
    <menuitem id="menu_stockai_procurement_preferences" name="Recommendation Preferences" parent="menu_stockai_procurement_root" action="action_stockai_procurement_preferences" sequence="10" groups="stockai_procurement.group_stockai_procurement_config_admin"/>
</odoo>
