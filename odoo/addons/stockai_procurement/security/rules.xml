<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_stockai_budget_integration_company" model="ir.rule">
        <field name="name">StockAI budget integration company access</field>
        <field name="model_id" ref="model_stockai_procurement_budget"/>
        <field name="groups" eval="[(4, ref('group_stockai_procurement_integration'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="0"/>
        <field name="perm_create" eval="0"/>
        <field name="perm_unlink" eval="0"/>
    </record>

    <record id="rule_stockai_budget_config_admin_company" model="ir.rule">
        <field name="name">StockAI budget configuration administrator company access</field>
        <field name="model_id" ref="model_stockai_procurement_budget"/>
        <field name="groups" eval="[(4, ref('group_stockai_procurement_config_admin'))]"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="1"/>
        <field name="perm_write" eval="1"/>
        <field name="perm_create" eval="1"/>
        <field name="perm_unlink" eval="0"/>
    </record>
</odoo>
