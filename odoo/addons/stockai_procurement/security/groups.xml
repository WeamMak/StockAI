<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="group_stockai_procurement_integration" model="res.groups">
        <field name="name">StockAI Procurement Integration</field>
        <field name="api_key_duration">90</field>
        <field name="implied_ids" eval="[
            (4, ref('base.group_user')),
            (4, ref('purchase.group_purchase_user')),
            (4, ref('stock.group_stock_user')),
            (4, ref('account.group_account_readonly')),
            (4, ref('api_doc.group_allow_doc'))
        ]"/>
    </record>

    <record id="group_stockai_procurement_config_admin" model="res.groups">
        <field name="name">StockAI Procurement Configuration Administrator</field>
        <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
    </record>
</odoo>
